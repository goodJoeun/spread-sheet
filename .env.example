# 이 파일을 .env.local로 복사한 뒤 값을 채워 주세요. (.env.local은 git에 올라가지 않습니다)
#   cp .env.example .env.local
# 모든 값은 서버(Route Handler)에서만 읽으며 브라우저로 전달되지 않습니다.

# Claude Console(https://platform.claude.com/settings/keys)에서 발급한 API 키.
# 비워 두면 가짜 Claude API로 동작합니다(같은 SDK 경로, 실제와 같은 응답 형식).
ANTHROPIC_API_KEY=

# 사용할 모델 (기본값: claude-opus-5-5). 예: claude-sonnet-5-5, claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-5-5

# 생각하는 정도: low | medium | high (기본값: low, 빠른 응답 우선)
ANTHROPIC_EFFORT=low

# 1로 두면 API 키가 있어도 가짜 응답으로 동작합니다(지연·오류 재현용).
AI_MOCK=
